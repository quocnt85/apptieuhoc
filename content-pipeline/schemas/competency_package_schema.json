{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompetencyPackage",
  "type": "object",
  "required": [
    "package_id",
    "skill_name",
    "skill_group",
    "target_grade",
    "target_age_range",
    "learning_objectives",
    "sub_competencies"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "pattern": "^CP-[0-9]{3,}$"
    },
    "skill_name": {
      "type": "string"
    },
    "skill_group": {
      "type": "string"
    },
    "target_grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "target_age_range": {
      "type": "string",
      "example": "6-7"
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "sub_competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "description"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "recommended_duration_minutes": {
      "type": "integer",
      "default": 20
    }
  }
}
