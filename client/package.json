{
  "name": "novastars-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dialogue:compile": "node scripts/compile-dialogue.mjs",
    "build:dialogue-studio": "npm run dialogue:compile && tsc -b && vite build --mode dialogue-studio",
    "check:audio-safety": "node scripts/check-audio-safety.mjs",
    "check:parent-data-boundary": "node scripts/check-parent-data-boundary.mjs",
    "check:parent-native-privacy": "node scripts/check-parent-native-privacy.mjs",
    "check:capacitor-assets": "node scripts/check-capacitor-assets.mjs",
    "check:android-bundle-safety": "node scripts/check-android-bundle-safety.mjs",
    "build": "npm run dialogue:compile && npm run check:audio-safety && npm run check:parent-data-boundary && npm run check:parent-native-privacy && tsc -b && vite build && npm run check:parent-production-safety",
    "check:parent-production-safety": "node scripts/check-parent-production-safety.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:parent-auth": "node scripts/run-parent-auth-e2e.mjs",
    "cap:sync": "node scripts/sync-capacitor.mjs",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.0",
