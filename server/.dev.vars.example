# Copy this file to server/.dev.vars for local Worker development only.
# Never commit real values. Migration and verification scripts load server/.dev.vars
# automatically; an already-set process environment variable takes precedence.
NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional: use the same experimental database URL to run the isolated-schema harness.
NEON_INTEGRATION_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
SESSION_PEPPER="replace-with-at-least-32-random-bytes"
OTP_PEPPER="replace-with-at-least-32-random-bytes"
PIN_PEPPER="replace-with-at-least-32-random-bytes"
REVENUECAT_WEBHOOK_SECRET="replace-before-enabling-iap"
ADMIN_UPLOAD_SECRET="replace-before-enabling-admin-upload"
